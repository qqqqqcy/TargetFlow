    },
    "Customize card titles, summaries, and detailed summaries for all configured providers." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有已配置的服务自定义卡片标题、摘要和详细摘要。"
