    },
    "Open screen recording settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开录屏设置"
          }
        }
      }
    },
    "Enable Target Flow in System Settings → Privacy & Security → Screen & System Audio Recording. Return here to check the status. If access still does not work, quit Target Flow completely and reopen it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在「系统设置 → 隐私与安全性 → 屏幕与系统音频录制」中开启 Target Flow，返回此处会自动检查授权状态。如果仍无法录制，请完全退出 Target Flow 后重新打开。"
          }
        }
      }
    },
    "Events and Goals": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件与目标"
          }
        }
