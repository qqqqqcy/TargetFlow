        }
      }
    },
    "Enabled instructions apply to every provider and model. Disabled sections use each provider's defaults." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用的指令适用于所有服务和模型。未启用的部分使用各服务的默认设置。"
