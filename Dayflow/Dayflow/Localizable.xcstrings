    "Check complete: screen recording permission is missing. Click Open screen recording settings to grant access." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查完成：尚未获得录屏权限。请点击「打开录屏设置」进行授权。"
          }
        }
      }
    },
    "Check complete: screen recording permission is granted and recording is enabled. This check does not verify captured frames." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查完成：已获得录屏权限，录制开关已开启。本次检查不验证实际截屏是否成功。"
          }
        }
      }
    },
    "Check complete: screen recording permission is granted. Recording is paused; use Resume on the timeline to start." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
