    "The selected provider or model does not support reasoning effort ‘%@’." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选服务商或模型不支持推理强度“%@”。" } } } },
    "Model names must be single lines without control characters." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型名称必须为单行，且不能包含控制字符。" } } } },
    "Model preferences could not be saved. Please try again." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法保存模型配置，请重试。" } } } },
    "Text generation" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文本生成" } } } },
