      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权"
          }
        }
      }
    },
    "Banners or alerts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅或提醒"
          }
        }
      }
    },
    "Card generation interval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片生成间隔"
          }
        }
