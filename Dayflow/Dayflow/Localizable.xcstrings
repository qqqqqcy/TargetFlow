    },
    "Cards update automatically at the generation interval in Settings, with additional time for AI processing. Choose 5, 10, or 15 minutes in Settings → Recording & Reminders.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片会按设置中的生成间隔自动更新，AI 处理还需要一些时间。可在“设置 → 记录与提醒”选择 5、10 或 15 分钟。"
          }
        }
      }
    },
    "Choose sound": {
      "localizations": {
